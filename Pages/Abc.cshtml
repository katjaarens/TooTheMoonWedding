@page "/abc"
@{
    ViewData["Title"] = "Hochzeits-ABC";
    Layout = "_Layout";
}

<div style="padding: 3rem 1.5rem; max-width: 1000px; margin: 0 auto; color: #ffffff; font-family: 'Handlee', cursive, sans-serif;">

    <!-- Header -->
    <div style="text-align: center; margin-bottom: 3.5rem;">
        <span style="font-family: 'Pinyon Script', cursive; font-size: 4.8rem; color: #e6cfa9; display: block;">
            Von A bis Z
        </span>
        <h1 style="font-family: 'Alex Brush', cursive; font-size: 4.8rem; color: #e6cfa9; margin: 0; line-height: 1.1;">
            Unser Hochzeits-ABC
        </h1>
        <p class="abc-text">
            Hier findet ihr die wichtigsten Details im Schnelldurchlauf.
        </p>
    </div>

    <!-- ABC Liste -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem;">

        <!-- A -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                A
            </span>
            <h3 class="abc-title-small">
                Anstoßen
            </h3>
            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Glasklieren ausdrücklich erwünscht! Wir wollen mit euch auf die nächsten gemeinsamen Jahre anstoßen.
            </p>
        </div>

        <!-- B -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                B
            </span>
            <h3 class="abc-title">Buffet</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Es gibt ein reichhaltiges Buffet, bei dem für jeden Geschmack etwas Leckeres dabei ist!
            </p>
        </div>

        <!-- C -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                C
            </span>
            <h3 class="abc-title-small">Check-in</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Der gemütliche Empfang findet am Abend vor der Hochzeit ab 19 Uhr im Brauhaus statt.
            </p>
        </div>

        <!-- D -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                D
            </span>
            <h3 class="abc-title-small">Dresscode</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Kommt in festlicher Garderobe – fühlt euch wohl, aber farbenfroh ist sehr gerne gesehen.
            </p>
        </div>

        <!-- E -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                E
            </span>
            <h3 class="abc-title-small">Erinnerungen</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Damit kein Moment verloren geht, liegen Einwegkameras auf den Tischen – knipst drauf los!
            </p>
        </div>

        <!-- F -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                F
            </span>
           <h3 class="abc-title-small">Flitterwochen</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Wissen wir aktuell noch nicht – erst wird gefeiert, der Rest ergibt sich.
            </p>
        </div>

        <!-- G -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                G
            </span>
            <h3 class="abc-title-small">Geschenke</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Dazu findet ihr alle wichtigen Infos und Wünsche auch nochmal gesammelt bei uns in den FAQs!
            </p>
        </div>

        <!-- H -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                H
            </span>
            <h3 class="abc-title-small">Handys</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Dürfen gerne gezückt werden und im Laufe des Tages zum Einsatz kommen, sofern sie niemanden stören.
            </p>
        </div>

        <!-- I -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                I
            </span>
            <h3 class="abc-title-small">Ideen</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Habt ihr kreative Ideen für Programmpunkte? Besprecht diese am besten kurz mit unseren Trauzeugen.
            </p>
        </div>

        <!-- J -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                J
            </span>
            <h3 class="abc-title-small">Ja-Wort</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Der absolute Höhepunkt des Tages – das kleine Wort mit einer riesigen Bedeutung.
            </p>
        </div>

        <!-- K -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                K
            </span>
           <h3 class="abc-title-small">Kinder</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Kinder sind bei unserer Feier von Herzen willkommen und machen den Tag noch lebendiger.
            </p>
        </div>

        <!-- L -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                L
            </span>
            <h3 class="abc-title-small">Lieder</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Welchen Song wollt ihr auf der Tanzfläche hören? Schreibt uns eure Musikwünsche direkt ins RSVP.
            </p>
        </div>

        <!-- M -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                M
            </span>
            <h3 class="abc-title-small">Musik</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Sorgt später für Stimmung – musikalische Beiträge oder Überraschungen bitte mit unseren Trauzeugen koordinieren.
            </p>
        </div>

        <!-- N -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                N
            </span>
            <h3 class="abc-title-small">Nachname</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Welchen gemeinsamen Nachnamen wir tragen werden? Lasst euch überraschen – das verraten wir erst vor dem Altar!
            </p>
        </div>

        <!-- O -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                O
            </span>
            <h3 class="abc-title-small">Organisation</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Bei Fragen zum Ablauf stehen euch unsere Trauzeugen mit Rat und Tat zur Seite.
            </p>
        </div>

        <!-- P -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                P
            </span>
            <h3 class="abc-title-small">Party</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Nach dem Genuss am Buffet wird das Tanzbein geschwungen und bis in die Nacht gefeiert.
            </p>
        </div>

        <!-- Q -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                Q
            </span>
            <h3 class="abc-title-small">Quatschen</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Ausgiebiges Quatschen und Lachen haben wir nach über 10 Jahren Beziehung als festes Fundament für unsere Ehe eingeplant.
            </p>
        </div>

        <!-- R -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                R
            </span>
            <h3 class="abc-title-small">Reden</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Schöne Worte und Reden bereichern den Tag. Bitte stimmt den genauen Zeitpunkt mit unserem Zeremonienmeister ab.
            </p>
        </div>

        <!-- S -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                S
            </span>
           <h3 class="abc-title-small">Sektempfang</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Findet direkt im Anschluss an die Trauung statt, damit wir gemeinsam auf das frisch gebackene Ehepaar anstoßen können.
            </p>
        </div>

        <!-- T -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                T
            </span>
           <h3 class="abc-title-small">Tiere</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                So sehr wir unsere eigenen Hunde lieben: An diesem Tag dürfen Nuts & Urmel (und alle anderen Tiere) zur Entlastung zu Hause bleiben.
            </p>
        </div>

        <!-- U -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                U
            </span>
            <h3 class="abc-title-small">Überraschungen</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Überraschungen sind toll, solange sie das Brautprogramm nicht sprengen – sprecht euch dazu kurz mit den Trauzeugen ab.
            </p>
        </div>

        <!-- V -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                V
            </span>
            <h3 class="abc-title-small">Vegetarisch</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Am Buffet ist selbstverständlich auch für unsere vegetarischen und veganen Gäste bestens gesorgt.
            </p>
        </div>

        <!-- W -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                W
            </span>
            <h3 class="abc-title-small">Weddingbubbles</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Wir freuen uns riesig über einen bunten Seifenblasen-Regen, wenn wir frisch getraut aus der Kirche treten.
            </p>
        </div>

        <!-- X -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                X
            </span>
            <h3 class="abc-title-small">X-tra</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                X-tra Ausreden fürs Sitzenbleiben gelten nicht – an diesem Tag wird gefeiert und getanzt!
            </p>
        </div>

        <!-- Y -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                Y
            </span>
            <h3 class="abc-title-small">Ypsilon</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Der Weg zu unserer Location ist ausgeschildert – kommt alle sicher und gut bei uns an.
            </p>
        </div>

        <!-- Z -->
        <div style="background: rgba(15, 18, 28, 0.9); border: 1px solid rgba(230, 207, 169, 0.4); padding: 2rem; border-radius: 16px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); display:flex; flex-direction:column; align-items:center; text-align:center;">
            <span style="font-family: 'Pinyon Script', cursive; font-size: 3rem; color: #e6cfa9; display:block; margin-bottom:0.6rem;">
                Z
            </span>
            <h3 class="abc-title-small">Zum Schluss</h3>

            <p style="color:#d0d5dd; margin:0; line-height:1.6;">
                Unendlich vielen Dank, dass ihr diesen unvergesslichen Tag mit uns teilt und unser Leben so bereichert.
            </p>
        </div>

    </div>

    <!-- Zurück-Button -->
    <div style="text-align: center; margin-top: 3rem;">
        <a href="/" style="display: inline-block; background: transparent; border: 2px solid #e6cfa9; color: #e6cfa9; padding: 0.8rem 2rem; border-radius: 30px; text-decoration: none; font-weight: bold; transition: all 0.3s;">
            ← Zurück zur Startseite
        </a>
    </div>

</div>
