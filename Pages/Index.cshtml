                                <label style="color: #fff; font-size: 0.9rem; margin: 0;">🌱 Vegan:</label>
                                <input type="number" asp-for="Rsvp.CateringVegan" min="0" value="0" style="width: 90px; padding: 0.5rem; background: rgba(255,255,255,0.05); border: 1px solid rgba(230, 207, 169, 0.3); border-radius: 5px; color: #fff; text-align: center;" />
