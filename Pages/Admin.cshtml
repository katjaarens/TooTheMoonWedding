@page
@model TooTheMoonWedding.Pages.AdminModel
@{
    ViewData["Title"] = "Admin-Bereich";
    var attendingRsvps = Model.Rsvps.Where(r => r.IsAttending).ToList();
    int totalPersons = attendingRsvps.Sum(r => 1 + (string.IsNullOrEmpty(r.PartnerName) ? 0 : 1));
    var totalConfirmedSeats = Model.UnassignedGuests.Count + Model.Assignments.Where(a => !string.IsNullOrEmpty(a.GuestName)).Count();

    // --- Catering-Summen berechnen ---
    int totalOmnivore = attendingRsvps.Sum(r => int.TryParse(r.CateringOmnivore, out int v) ? v : 0);
    int totalVegetarian = attendingRsvps.Sum(r => int.TryParse(r.CateringVegetarian, out int v) ? v : 0);
    int totalVegan = attendingRsvps.Sum(r => int.TryParse(r.CateringVegan, out int v) ? v : 0);
}

<style>
    .admin-card {
        background-color: rgba(15, 18, 28, 0.95);
        border: 1px solid rgba(230, 207, 169, 0.3);
        border-radius: 16px;
        padding: 2.5rem;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
        color: #f8fafc;
    }
    .inner-box {
        background-color: rgba(20, 24, 38, 0.95);
        border: 1px solid rgba(230, 207, 169, 0.25);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .table-box {
        background-color: rgba(20, 24, 38, 0.95);
        border: 1px solid rgba(230, 207, 169, 0.25);
        border-radius: 12px;
        padding: 1.2rem;
        position: relative;
    }
    .guest-badge {
        background: rgba(15, 20, 32, 0.9);
        border: 1px solid rgba(230, 207, 169, 0.3);
        border-radius: 6px;
        padding: 0.4rem 0.8rem;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        margin: 3px;
        color: #f8fafc;
    }
    .btn-wedding {
        background: linear-gradient(135deg, #e6cfa9 0%, #c4ab82 100%);
        color: #0f121c;
        font-weight: 600;
        border: none;
    }
    .btn-wedding:hover {
        background: linear-gradient(135deg, #f3dbc0 0%, #d2b890 100%);
        color: #0f121c;
    }
    /* Allgemeine Aufhellung für Untertitel und Labels */
    .text-muted {
        color: #cbd5e1 !important;
    }
    label, .form-label {
        color: #e2e8f0 !important;
    }
    ::placeholder {
        color: #94a3b8 !important;
        opacity: 1;
    }
</style>

<div class="container mt-4 mb-5" style="max-width: 1300px;">
    <div class="admin-card">
        
        <!-- Header & Logout -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom" style="border-color: rgba(230, 207, 169, 0.15) !important;">
            <div>
                <h2 style="color: #e6cfa9; font-family: 'Alex Brush', cursive; font-size: 3.5rem;" class="mb-0">Hochzeits-Administration</h2>
                <p class="text-muted mb-0" style="color: #cbd5e1 !important;">Eingeloggt als: <strong style="color: #f3dbc0;">@Model.LoggedInAdminName</strong></p>
            </div>
            <div>
                <form method="post" asp-page-handler="Logout" class="mb-0">
                    <button type="submit" class="btn btn-outline-warning btn-sm">Abmelden</button>
                </form>
            </div>
        </div>

        <!-- TEIL 1: RSVP & STATISTIK -->
        <div class="inner-box mb-4">
            <h4 style="color: #e6cfa9;" class="mb-3">📊 Planungs- & Gäste-Übersicht</h4>
            
            <!-- Statistik-Kacheln (Gesamtpersonen + Catering) -->
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 rounded bg-black border border-secondary">
                        <small class="text-uppercase fw-bold" style="color: #94a3b8;">Gesamtpersonen mit Zusage</small>
                        <h3 class="text-white mb-0">@totalPersons</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-black border border-secondary">
                        <small class="text-uppercase fw-bold" style="color: #e6cfa9;">🥩 Klassisch</small>
                        <h3 class="text-white mb-0">@totalOmnivore</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-black border border-secondary">
                        <small class="text-uppercase fw-bold" style="color: #e6cfa9;">🌱 Vegetarisch</small>
                        <h3 class="text-white mb-0">@totalVegetarian</h3>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 rounded bg-black border border-secondary">
                        <small class="text-uppercase fw-bold" style="color: #e6cfa9;">🥑 Vegan</small>
                        <h3 class="text-white mb-0">@totalVegan</h3>
                    </div>
                </div>
            </div>

            <h5 style="color: #e6cfa9;" class="mt-4 mb-3">Eingegangene RSVP-Antworten (@Model.Rsvps.Count)</h5>
            <div class="table-responsive">
                <table class="table table-dark table-striped table-hover align-middle small">
                    <thead>
                        <tr style="color: #e6cfa9;">
                            <th>Name</th>
                            <th>E-Mail</th>
                            <th>Status</th>
                            <th>Personen</th>
                            <th>Essen / Verpflegung</th>
                            <th>Aktion</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Rsvps.Any())
                        {
                            <tr><td colspan="6" class="text-center text-muted py-3">Noch keine Antworten eingegangen.</td></tr>
                        }
                        else
                        {
                            @foreach (var rsvp in Model.Rsvps)
                            {
                                <tr style="color: #f8fafc;">
                                    <td>
                                        <strong style="color: #ffffff;">@rsvp.Name</strong>
                                        @if(!string.IsNullOrEmpty(rsvp.PartnerName)) { <br/><span style="color: #cbd5e1;">+ @rsvp.PartnerName</span> }
                                    </td>
                                    <td style="color: #e2e8f0;">@rsvp.Email</td>
                                    <td>
                                        @if (rsvp.IsAttending) { <span class="badge bg-success">Zusage</span> }
                                        else { <span class="badge bg-danger">Absage</span> }
                                    </td>
                                    <td style="color: #e2e8f0;">
                                        @(1 + (string.IsNullOrEmpty(rsvp.PartnerName) ? 0 : 1)) Pers.
                                    </td>
                                    <td style="color: #e2e8f0;">
                                        @if (rsvp.IsAttending)
                                        {
                                            <div style="display: flex; flex-direction: column; gap: 0.1rem;">
                                                @if (!string.IsNullOrEmpty(rsvp.CateringOmnivore) && rsvp.CateringOmnivore != "0")
                                                {
                                                    <span>🥩 @rsvp.CateringOmnivore× Klassisch</span>
                                                }
                                                @if (!string.IsNullOrEmpty(rsvp.CateringVegetarian) && rsvp.CateringVegetarian != "0")
                                                {
                                                    <span>🌱 @rsvp.CateringVegetarian× Vegetarisch</span>
                                                }
                                                @if (!string.IsNullOrEmpty(rsvp.CateringVegan) && rsvp.CateringVegan != "0")
                                                {
                                                    <span>🥑 @rsvp.CateringVegan× Vegan</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(rsvp.Allergies))
                                            {
                                                <div style="margin-top: 0.3rem; font-size: 0.75rem; color: #e6cfa9; background: rgba(230,207,169,0.1); padding: 0.1rem 0.3rem; border-radius: 3px;">
                                                    ⚠️ @rsvp.Allergies
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="DeleteRsvp" asp-route-id="@rsvp.Id" class="mb-0">
                                            <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-2" onclick="return confirm('Wirklich löschen?');">Löschen</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TEIL 2: SITZPLAN VERWALTUNG -->
        <div class="pt-3 border-top" style="border-color: rgba(230, 207, 169, 0.15) !important;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h3 style="color: #e6cfa9; font-family: 'Alex Brush', cursive; font-size: 2.8rem;" class="mb-0">Sitzplan verwalten</h3>
                    <p class="text-muted mb-0 small">Weise die zugesagten Gäste den Tischen zu.</p>
                </div>
                <span class="px-3 py-2 rounded text-white small bg-black border border-secondary">
                    Zugewiesen: <strong style="color: #e6cfa9;">@totalConfirmedSeats P.</strong>
                </span>
            </div>

            <div class="row">
                <!-- Linke Spalte: Unzugewiesene Gäste & Neuer Tisch -->
                <div class="col-lg-4">
                    <div class="inner-box">
                        <h5 style="color: #e6cfa9;" class="mb-2">Unzugewiesene Gäste (@Model.UnassignedGuests.Count)</h5>
                        <p class="small mb-3" style="color: #cbd5e1;">Gäste ohne festen Platz:</p>
                        
                        @if (!Model.UnassignedGuests.Any())
                        {
                            <div class="text-center py-3 small border border-secondary border-dashed rounded" style="color: #cbd5e1;">
                                Alle Gäste haben einen Platz! 🎉
                            </div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-2">
                                @foreach (var guestName in Model.UnassignedGuests)
                                {
                                    <div class="p-2 rounded bg-black border border-secondary d-flex justify-content-between align-items-center">
                                        <span class="small" style="color: #f8fafc;"><strong>@guestName</strong></span>
                                        <form method="post" asp-page-handler="Assign" class="d-flex gap-1 mb-0">
                                            <input type="hidden" name="guestName" value="@guestName" />
                                            <select name="targetTable" class="form-select form-select-sm bg-dark text-white border-secondary" style="font-size: 0.8rem;" required>
                                                <option value="">Tisch...</option>
                                                @foreach (var tableName in Model.Assignments.Select(a => a.TableName).Distinct())
                                                {
                                                    <option value="@tableName">@tableName</option>
                                                }
                                            </select>
                                            <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2">✓</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    <div class="inner-box">
                        <h5 style="color: #e6cfa9;" class="mb-3">Neuen Tisch erstellen</h5>
                        <form method="post" asp-page-handler="AddTable">
                            <div class="mb-3">
                                <label class="form-label small">Tischname</label>
                                <input type="text" asp-for="TableName" class="form-control bg-black text-white border-secondary" placeholder="z. B. Ehrentisch" required />
                            </div>
                            <button type="submit" class="btn btn-wedding w-100 py-2">Tisch hinzufügen</button>
                        </form>
                    </div>
                </div>

                <!-- Rechte Spalte: Tisch-Layout im Raum -->
                <div class="col-lg-8">
                    <h5 style="color: #e6cfa9;" class="mb-3">Tisch-Layout im Raum</h5>
                    <div class="row g-3">
                        @{
                            var tableGroups = Model.Assignments.GroupBy(a => a.TableName).ToList();
                        }

                        @if (!tableGroups.Any())
                        {
                            <div class="col-12">
                                <div class="table-box text-center py-5" style="color: #cbd5e1;">
                                    Noch keine Tische erstellt. Erstelle links einen neuen Tisch!
                                </div>
                            </div>
                        }
                        else
                        {
                            @foreach (var group in tableGroups)
                            {
                                var guestsAtTable = group.Where(g => !string.IsNullOrEmpty(g.GuestName)).ToList();
                                <div class="col-md-6">
                                    <div class="table-box h-100">
                                        <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom border-secondary">
                                            <div class="d-flex align-items-center gap-2">
                                                <h6 class="mb-0" style="color: #e6cfa9;"><strong>@group.Key</strong></h6>
                                                <span class="badge bg-secondary text-white small">@guestsAtTable.Count P.</span>
                                            </div>
                                            <form method="post" asp-page-handler="DeleteTable" asp-route-tableName="@group.Key" class="mb-0">
                                                <button type="submit" class="btn btn-sm btn-outline-danger py-0 px-1" title="Tisch löschen" style="font-size: 0.75rem;">Tisch löschen</button>
                                            </form>
                                        </div>

                                        <div class="d-flex flex-wrap gap-1 mt-2">
                                            @if (!guestsAtTable.Any())
                                            {
                                                <span class="small fst-italic" style="color: #94a3b8;">Tisch ist noch leer.</span>
                                            }
                                            else
                                            {
                                                @foreach (var item in guestsAtTable)
                                                {
                                                    <div class="guest-badge">
                                                        <span style="color: #f8fafc;">@item.GuestName</span>
                                                        <form method="post" asp-page-handler="RemoveGuest" asp-route-id="@item.Id" class="mb-0 d-inline">
                                                            <button type="submit" class="btn btn-link text-danger p-0 ms-1 text-decoration-none" style="font-size: 0.8rem;">×</button>
                                                        </form>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>